# Copy this file to ".env" (optional). Real environment variables always take priority.

# Used to sign login session cookies. Set your own long random value for anything beyond local demos.
# Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Optional: where the SQLite file lives (default: instance/taskflow.db)
# DATABASE_PATH=instance/taskflow.db

# Optional: set to 1 only when serving over HTTPS
# SESSION_COOKIE_SECURE=1

# Optional: set to 1 for Flask debug mode and auto-reload
# FLASK_DEBUG=1
